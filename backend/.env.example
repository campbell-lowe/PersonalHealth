# Backend environment variables
PORT=3000

# Optional: Use Postgres in production for persistent account data.
# Example (Supabase/Neon/Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated frontend origins allowed to call /api routes.
# Example:
# APP_ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:5173
APP_ALLOWED_ORIGINS=

# Optional account bootstrap on startup.
APP_DEFAULT_USERNAME=
APP_DEFAULT_PASSWORD=

# Optional demo account override.
APP_DEMO_USERNAME=demo
APP_DEMO_PASSWORD=demo12345
